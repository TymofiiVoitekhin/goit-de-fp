FROM apache/airflow:2.10.3-python3.11

USER root

# Встановлення Java 17 (JRE) для роботи Apache Spark та базових системних утиліт
RUN apt-get update && \
    apt-get install -y --no-install-recommends openjdk-17-jre-headless procps && \
    ln -s /usr/lib/jvm/java-17-openjdk-* /usr/lib/jvm/java-17-openjdk && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk
ENV PATH="${JAVA_HOME}/bin:/home/airflow/.local/bin:${PATH}"

USER airflow

# Встановлення Python-залежностей проєкту
COPY requirements.txt /requirements.txt
RUN pip install --no-cache-dir -r /requirements.txt

# Підготовка директорії кешу Ivy та прав групи 0 для запуску під UID хосту
USER root
RUN mkdir -p /home/airflow/.ivy2 && \
    chmod -R g+rwX /home/airflow /opt/airflow

USER airflow
